{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug with tsx",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "tsx",
      "runtimeArgs": [
        "watch",
        "${workspaceFolder}/tests/example.ts"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js",
        "!**/node_modules/**"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/dist/**",
        "${workspaceFolder}/src/**",
        "${workspaceFolder}/tests/**",
        "!**/node_modules/**"
      ]
    },
    {
      "name": "Debug with vite-node (watch)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "vite-node",
      "runtimeArgs": [
        "--watch",
        "${workspaceFolder}/tests/example.ts"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js",
        "!**/node_modules/**"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/dist/**",
        "${workspaceFolder}/src/**",
        "${workspaceFolder}/tests/**",
        "!**/node_modules/**"
      ]
    }
  ]
}
