{
  "name": "zod-to-drizzle",
  "version": "0.2.1",
  "description": "Create Drizzle ORM tables from Zod schemas",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "build": "tsup",
    "prepare": "npm run build",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "drizzle",
    "zod",
    "schema",
    "orm",
    "typescript",
    "sqlite",
    "postgres",
    "mysql"
  ],
  "author": "bil0ak <contact@bilalakkil.com> (https://github.com/bil0ak)",
  "repository": "https://github.com/bil0ak/zod-to-drizzle",
  "homepage": "https://github.com/bil0ak/zod-to-drizzle",
  "license": "MIT",
  "dependencies": {
    "drizzle-orm": "~0.45.1",
    "semantic-release": "24.2.7",
    "zod": "4.3.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "24.0.15",
    "prettier": "3.6.2",
    "tsup": "8.5.0",
    "typescript": "5.8.3",
    "vite-node": "5.2.0"
  },
  "peerDependencies": {
    "drizzle-orm": "~0.45.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "22.11.0"
  }
}
